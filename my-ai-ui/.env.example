# Vite variables are compiled into the browser bundle. These are public client
# configuration only; never put API tokens, Firebase Admin credentials, or
# backend secrets in this file.
VITE_CHAT_API_URL=http://localhost:8080/api/v1/chat/query
VITE_FIREBASE_API_KEY=replace-with-firebase-web-app-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
